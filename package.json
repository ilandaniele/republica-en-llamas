{
  "name": "republica-en-llamas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "npm test --workspace=packages/game-engine -- --coverage.enabled && npm test --workspace=apps/web -- --coverage.enabled && npm test --workspace=apps/api -- --coverage.enabled --coverage.provider=v8",
    "test:security": "npm test --workspace=apps/api && node --import tsx --test scripts/security/load.test.mjs scripts/security/k6-guards.test.mjs",
    "test:load": "node scripts/security/run-load.mjs",
    "test:load:api": "node scripts/security/run-api-load.mjs",
    "lint": "eslint .",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "verify:content": "tsx scripts/verify-content.ts",
    "deploy": "npm run build --workspace=apps/web && npm run deploy --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "gif-encoder-2": "^1.0.5",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.2.3"
}
