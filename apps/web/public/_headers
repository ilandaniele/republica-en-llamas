/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://*.posthog.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/illustrations/*
  Cache-Control: public, max-age=3600
